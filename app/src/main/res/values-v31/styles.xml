<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ splash screen: give the launch window a real background and a proper icon,
         so the system splash screen can morph into the app window instead of showing a
         background-less icon floating on top of the launcher. -->
    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/theme_light_background_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/theme_light_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>

</resources>
